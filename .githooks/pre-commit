#!/usr/bin/env bash
# Second Brain pre-commit hook.
#  1. If glossary_autolink is enabled, link known glossary terms in staged notes and
#     re-stage them (scripts/glossary_autolink_staged.py) — BEFORE embedding, so a note
#     embeds with its links. No-op when the toggle is off (the default).
#  2. Regenerate `.embed.json` sidecars for staged PARA notes and stage them into
#     the same commit (scripts/embed_staged.py).
#  3. Warn — never block — when a staged Markdown note exceeds 300 non-empty lines
#     (scripts/check_line_count.py, Task 0002). Excludes README.md and tasks/.
#  4. Refuse the commit if a note's no-embed / lexical-only fences are malformed
#     (scripts/check_fences.py) — a broken fence excludes nothing, silently.
#  5. Refuse the commit if two notes anywhere in the vault share a filename
#     (scripts/check_unique_names.py) — Obsidian resolves [[wikilinks]] by name.
#  6. If encryption is enabled, encrypt the notes that changed and stage their blobs
#     (scripts/encrypt_vault.py --precommit). Silent no-op when the toggle is off.
set -euo pipefail
ROOT="$(git rev-parse --show-toplevel)"

python3 "$ROOT/scripts/glossary_autolink_staged.py"
python3 "$ROOT/scripts/embed_staged.py"

# The note list comes from note_selection.py, NOT from `git diff --cached -- '*.md'`.
# An encrypted brain git-ignores the vault, so git stages no note and that query returns
# an empty string — the guard below would then never fire again, without ever failing.
notes="$(python3 "$ROOT/scripts/note_selection.py")"
if [ -n "$notes" ]; then
  # shellcheck disable=SC2086  # intentional word-split; note paths have no spaces
  python3 "$ROOT/scripts/check_line_count.py" $notes || true
fi

# Validate the exclusion fences on the notes being committed. A malformed fence excludes
# NOTHING, so the region a human meant to keep out of the index is embedded anyway — silent,
# because the note commits and renders correctly either way. Blocks, like the uniqueness check
# below: an unnoticed fence typo can put reference data or a private number into a vector.
if [ -n "$notes" ]; then
  # shellcheck disable=SC2086  # intentional word-split; note paths have no spaces
  python3 "$ROOT/scripts/check_fences.py" $notes
fi

# Refuse two notes with the same filename anywhere in the vault. Obsidian resolves
# [[wikilinks]] by NAME, so a duplicate makes every link to it ambiguous and silently
# unroutable. Until subfolders existed this held by accident — a directory cannot contain two
# files of one name — so nothing ever had to check it. BLOCKS the commit, unlike the
# line-count guard above, because the damage is invisible at the time and the fix is a rename.
if [ -n "$notes" ]; then
  # shellcheck disable=SC2086  # intentional word-split; note paths have no spaces
  python3 "$ROOT/scripts/check_unique_names.py" $notes
fi

# 5. If encryption is on, re-encrypt the notes that changed and stage their blobs. LAST,
#    because step 1 may have edited a note and the blob has to carry the text actually
#    being committed. A silent no-op — not even a passphrase lookup — when the toggle is
#    off, which is every brain that never turned it on.
python3 "$ROOT/scripts/encrypt_vault.py" --precommit
